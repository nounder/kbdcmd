<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime refuses to even prompt for the microphone without this. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Sending synthetic events and driving other apps over Apple events. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Parakeet models are mapped from disk and run through the ANE/GPU. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
